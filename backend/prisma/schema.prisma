// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("MECHANIC")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  
  mechanicProfile MechanicProfile?
}

model MechanicProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone           String?
  specialty       String?  @default("General Mechanic")
  experienceYears Int?     @default(1)
  shiftHours      String?
  dailySalary     Float?
  monthlySalary   Float?
  rating          Float?   @default(4.9)
  
  jobs            JobCard[] @relation("AssignedMechanic")
  bayAllocations  BayAllocation[]
  attendance      Attendance[]
}

model Attendance {
  id          String   @id @default(uuid())
  mechanicId  String
  mechanic    MechanicProfile @relation(fields: [mechanicId], references: [id], onDelete: Cascade)
  date        DateTime
  status      String   @default("PRESENT")
  createdAt   DateTime @default(now())

  @@unique([mechanicId, date])
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  email     String?
  address   String?
  gender    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  vehicles  Vehicle[]
  jobCards  JobCard[]
}

model Vehicle {
  id            String   @id @default(uuid())
  registrationNo String   @unique
  make          String
  model         String
  fuelType      String
  year          Int?
  color         String?
  odometer      Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobCards      JobCard[]
}

model JobCard {
  id          String   @id @default(uuid())
  jobNo       String?  @unique
  status      String   @default("PENDING")
  description String
  images      String?
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  mechanicId  String?
  mechanic    MechanicProfile? @relation("AssignedMechanic", fields: [mechanicId], references: [id])
  estimatedCost Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  payments    Payment[]
  invoices    Invoice[]
  bayAllocations BayAllocation[]

  @@index([status])
  @@index([customerId])
}

model InventoryItem {
  id          String   @id @default(uuid())
  name        String
  partNumber  String   @unique
  quantity    Int      @default(0)
  minQuantity Int      @default(5)
  price       Float
  supplierId  String?
  supplierRef Supplier? @relation(fields: [supplierId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  poItems     PurchaseOrderItem[]
}

model Payment {
  id            String   @id @default(uuid())
  jobCardId     String?
  jobCard       JobCard? @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  amount        Float
  paymentMethod String
  status        String   @default("COMPLETED")
  transactionId String?
  upiQrData     String?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

model Invoice {
  id           String   @id @default(uuid())
  invoiceNo    String   @unique
  customerName String
  vehicleNo    String
  partsTotal   Float
  laborTotal   Float
  taxAmount    Float
  taxRate      Float?   @default(18)
  grandTotal   Float
  status       String   @default("UNPAID")
  jobCardId    String?
  jobCard      JobCard? @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?
}

model Supplier {
  id            String   @id @default(uuid())
  name          String
  contactPerson String?
  phone         String
  email         String?
  gstin         String?
  address       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
  inventory     InventoryItem[]
  purchaseOrders PurchaseOrder[]
}

model ServiceBay {
  id            String   @id @default(uuid())
  bayNumber     String   @unique
  bayType       String   @default("STANDARD")
  status        String   @default("AVAILABLE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  allocations   BayAllocation[]
}

model BayAllocation {
  id               String      @id @default(uuid())
  bayId            String
  bay              ServiceBay  @relation(fields: [bayId], references: [id])
  jobCardId        String
  jobCard          JobCard     @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  mechanicId       String?
  mechanic         MechanicProfile? @relation(fields: [mechanicId], references: [id])
  startTime        DateTime    @default(now())
  estimatedEndTime DateTime?
  actualEndTime    DateTime?

  @@index([actualEndTime])
}

model PurchaseOrder {
  id            String   @id @default(uuid())
  poNumber      String   @unique
  supplierId    String
  supplier      Supplier @relation(fields: [supplierId], references: [id])
  status        String   @default("DRAFT")
  totalAmount   Float
  expectedDelivery DateTime?
  items         PurchaseOrderItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?
}

model PurchaseOrderItem {
  id              String   @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  quantity        Int
  unitCost        Float
  unitPrice       Float?
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
